# NestJS / Node backend .gitignore

# Dependencies
/node_modules
# package-lock.json is intentionally committed: `npm ci` requires it, and
# CI plus both Dockerfiles rely on `npm ci` for reproducible installs.
# Ignoring it made every one of those fail on a fresh clone.

# Build output
/dist
/build

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Runtime data
/uploads
/scratch
/temp

# Environment
.env
.env.test
.env.production

# IDE
.vscode
.idea

# Prisma
/prisma/migrations
