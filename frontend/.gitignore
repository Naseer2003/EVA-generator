# Next.js frontend .gitignore

# Dependencies
/node_modules
# package-lock.json is intentionally committed: `npm ci` requires it, and
# CI plus both Dockerfiles rely on `npm ci` for reproducible installs.
# Ignoring it made every one of those fail on a fresh clone.

# Next.js build output
/.next/
/out/
/build

# Production
.next/
out/

# Environment variables
.env*
!.env.example

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Misc
.DS_Store
*.pem
