# Root .gitignore for EVA Platform

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Project specific
/brain/
node_modules/
dist/
.next/
*.log

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Python venvs and cache
venv/
.venv/
env/
__pycache__/
*.pyc

# Local Uploads and Scratch
uploads/
results/
temp/
scratch/
*.txt
# ...but dependency manifests are not scratch. Without this exception a fresh
# clone has no requirements-docker.txt and both the CI job and the engine image
# build fail with "file not found".
!**/requirements*.txt
audit_all.py
verify_fix.py
test_ad*.py
list_all.*
