# Copy to .env and fill in. .env is gitignored — never commit real values.
#
#   cp .env.example .env
#   docker compose up --build

# ── Database (required) ──────────────────────────────────────────────────────
# Serverless Postgres (Neon) or any Postgres 14+. Prisma supplies this to the
# pg driver adapter at runtime; the schema's datasource block carries no url.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Direct (non-pooled) connection, used by `prisma migrate`. On Neon this is the
# endpoint without -pooler. Defaults to DATABASE_URL if unset.
DIRECT_URL=

# ── Auth (required) ──────────────────────────────────────────────────────────
# Generate one: openssl rand -base64 48
# Rotating this invalidates every issued token, logging all users out.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── URLs ─────────────────────────────────────────────────────────────────────
# Origin allowed by the backend's CORS policy — where the browser loads the UI.
FRONTEND_URL=http://localhost:3000

# BUILD-TIME ONLY. Inlined into the client bundle by `next build`, so changing
# it requires `docker compose build frontend`, not a restart. Must be the URL
# the browser uses — http://backend:3001 will not resolve outside the network.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_EVA_ENGINE_URL=http://localhost:8000

# ── Published ports ──────────────────────────────────────────────────────────
FRONTEND_PORT=3000
BACKEND_PORT=3001

# ── Tuning ───────────────────────────────────────────────────────────────────
# Engine worker processes. The AD test runs a 5000-trial Monte Carlo with an
# MLE re-fit per trial, so this is CPU-bound — keep it at or below your CPU
# allocation.
UVICORN_WORKERS=1

MAX_FILE_SIZE_MB=50
